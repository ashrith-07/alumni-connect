// firestore.rules
// Firestore Security Rules: checked on Google's servers for EVERY read and write.
// Even if someone bypasses our app, these rules still protect the database.
// HOW TO USE: copy this whole file into Firebase Console -> Firestore Database -> Rules -> Publish.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------

    // Is the person logged in?
    function signedIn() {
      return request.auth != null;
    }

    // Read the role ("student", "alumni" or "admin") of the logged-in person
    // from their document in the "users" collection.
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Has an admin removed (blocked) the logged-in person?
    // .get('removed', false) means "use false if the field doesn't exist".
    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('removed', false) == false;
    }

    // ---------- users collection ----------
    match /users/{userId} {
      // Any logged-in user can view profiles (needed for the Directory).
      allow read: if signedIn();

      // At sign up, you can only create YOUR OWN document,
      // you can only pick "student" or "alumni" (nobody can sign up as admin),
      // and you cannot mark yourself verified or removed.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['student', 'alumni']
        && !('verified' in request.resource.data)
        && !('removed' in request.resource.data);

      // You can only edit YOUR OWN profile (if you're not removed),
      // and you cannot change your role, verified badge or removed status.
      allow update: if signedIn()
        && request.auth.uid == userId
        && isActive()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verified', 'removed']);

      // Admins can change ONLY "verified" and "removed" on other users (not on admins).
      allow update: if signedIn()
        && myRole() == 'admin'
        && resource.data.role != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'removed']);

      // Nobody can delete profiles from the app.
      allow delete: if false;
    }

    // ---------- events collection ----------
    match /events/{eventId} {
      // Any logged-in user can view events.
      allow read: if signedIn();

      // Only admins can create or delete events.
      allow create, delete: if signedIn() && myRole() == 'admin';

      // Updating an event:
      // - admins can change anything
      // - everyone else can ONLY change the "rsvps" list,
      //   and only by adding or removing THEIR OWN uid.
      // - removed users can't RSVP at all.
      allow update: if signedIn() && isActive() && (
        myRole() == 'admin' || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps'])
          && request.resource.data.rsvps.toSet().difference(resource.data.rsvps.toSet())
               .union(resource.data.rsvps.toSet().difference(request.resource.data.rsvps.toSet()))
               .hasOnly([request.auth.uid])
        )
      );
    }

    // ---------- jobs collection ----------
    match /jobs/{jobId} {
      // Any logged-in user can view jobs.
      allow read: if signedIn();

      // Only alumni (who are not removed) can post jobs, and "postedBy" must be
      // their own uid (so nobody can post pretending to be someone else).
      allow create: if signedIn()
        && isActive()
        && myRole() == 'alumni'
        && request.resource.data.postedBy == request.auth.uid;

      // Only the person who posted a job can edit or delete it.
      allow update, delete: if signedIn() && resource.data.postedBy == request.auth.uid;
    }
  }
}
